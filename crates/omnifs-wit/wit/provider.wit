package omnifs:provider@0.10.0;

// === Shared types ===

interface types {
    type correlation-id = u64;
    type repo-id = u64;
    type tree-ref = u64;
    type file-handle = u64;
    type blob-id = u64;

    // --- Callouts (provider -> host, request/response) ---

    /// Work the host runs on the provider's behalf through async host
    /// imports. Every callout expects one typed `callout-result`; there
    /// are no fire-and-forget callouts, and provider returns never carry
    /// trailing callouts.
    variant callout {
        fetch(http-request),
        git-open-repo(git-open-request),
        /// HTTP fetch whose response body lands in the host's disk-backed
        /// blob cache instead of crossing the WIT boundary. Returns a
        /// `blob-id` plus response metadata; the bytes can later be served
        /// verbatim as read bytes (`byte-source.blob`).
        fetch-blob(blob-fetch-request),
    }

    // --- Callout results (host -> provider, non-recursive) ---

    variant callout-result {
        http-response(http-response),
        git-repo-opened(git-repo-info),
        blob-fetched(blob-fetched),
        callout-error(callout-error),
    }

    // --- Terminal host mutations ---

    /// Host-side mutations committed at the return boundary, grouped in typed
    /// blocks by target subsystem. The two byte-producing blocks are
    /// distinguished by verb: `canonical` STOREs raw upstream bytes into the
    /// object store; `fs` WRITEs materialized files and directories into the
    /// view cache.
    record effects {
        canonical: list<canonical-store>,
        fs: list<fs-write>,
        invalidations: list<invalidation>,
        /// Paths whose facts, with the facts beneath them, leave the
        /// projection; each leaves its parent listing as complete as it was.
        removals: list<string>,
    }

    record logical-id {
        kind: string,
        captures: list<id-capture>,
    }

    record id-capture {
        name: string,
        value: string,
    }

    /// Store raw upstream bytes against a logical object id. The canonical is
    /// exactly the upstream response body, verbatim; `validator` is
    /// host-opaque passthrough, and every representation under the object
    /// derives from these bytes. `view-leaves` are full absolute paths the
    /// host indexes for this id.
    record canonical-store {
        id: logical-id,
        validator: option<version-token>,
        bytes: list<u8>,
        view-leaves: list<string>,
    }

    /// Write a materialized file or directory into the view cache.
    ///
    /// For `directory`, the `listing-write` says how the children written at
    /// `<path>/<name>` in the same batch join the listing of `path`.
    record fs-write {
        id: option<logical-id>,
        path: string,
        kind: fs-kind,
    }

    variant fs-kind {
        file(file-out),
        directory(listing-write),
    }

    /// How the children of a directory write join its listing.
    enum listing-write {
        /// They join the listing, which stays as complete as it was unless
        /// they add names to it.
        partial,
        /// They are the whole listing, so a later readdir serves from cache
        /// without re-invoking `list-children`.
        exhaustive,
        /// They join the listing, which is complete after them.
        complete,
    }

    variant path-or-prefix {
        path(string),
        prefix(string),
    }

    /// Evict a cached object or a view listing.
    variant invalidation {
        object(logical-id),
        listing(path-or-prefix),
    }

    /// Canonical bytes the host pushes into `read-file` on a view-cache miss
    /// under a known object id, so the SDK renders without an upstream call.
    /// `id` is included so the SDK can self-check before rendering.
    /// `revalidate` asks the SDK to call the object's load path with the
    /// supplied validator instead of serving directly from `bytes`.
    record canonical-input {
        id: logical-id,
        validator: option<version-token>,
        bytes: list<u8>,
        revalidate: bool,
    }

    // --- Error types ---

    record callout-error {
        kind: error-kind,
        message: string,
        retryable: bool,
    }

    enum error-kind {
        not-found,
        not-a-directory,
        not-a-file,
        permission-denied,
        invalid-input,
        too-large,
        network,
        timeout,
        denied,
        rate-limited,
        version-mismatch,
        internal,
    }

    record provider-error {
        kind: error-kind,
        message: string,
        retryable: bool,
        // Structured backoff hint for `rate-limited` (HTTP `Retry-After`),
        // in seconds. The host reads this to size a rate-limit window; a
        // string-embedded value would not be machine-actionable.
        retry-after: option<u32>,
    }

    // --- File metadata and projection data ---

    type version-token = string;

    variant file-size {
        exact(u64),
        non-zero,
        unknown,
    }

    enum read-mode {
        full,
        ranged,
    }

    enum stability {
        stable,
        dynamic,
        live,
    }

    /// File metadata. Bytes are deliberately not attributes.
    record file-attrs {
        size: file-size,
        stability: stability,
        version-token: option<version-token>,
    }

    /// One byte source for any materialized file or representation.
    ///
    /// `canonical` is a reference: serve the canonical bytes at this entry's
    /// anchor without copying them across the WIT or duplicating them in the
    /// view cache. `deferred` is read-on-demand and valid only for
    /// projections and listing entries, never a `read-file` answer.
    variant byte-source {
        inline(list<u8>),
        canonical,
        blob(blob-id),
        deferred(read-mode),
    }

    /// A materialized file: a byte source plus attributes and an optional
    /// SDK-supplied content type the host echoes opaquely for a bare-name
    /// leaf the standard extension suffix map cannot type.
    record file-out {
        content-type: option<string>,
        attrs: file-attrs,
        bytes: byte-source,
    }

    variant entry-kind {
        directory,
        file(file-out),
    }

    record dir-entry {
        name: string,
        kind: entry-kind,
        id: option<logical-id>,
    }

    // --- Terminal payloads ---

    /// Lookup-child result. `subtree` answers the lookup/list operation. It
    /// is result data, not itself the host mutation.
    variant lookup-child-result {
        entry(lookup-entry),
        subtree(subtree),
        not-found(option<logical-id>),
        /// The path is fed: the host serves it from the projection once the
        /// answering feed among these claims has answered.
        feed(list<feed-claim>),
    }

    /// The non-subtree, non-miss shape of a lookup: the found entry plus
    /// cache-adjacent sibling data.
    record lookup-entry {
        target: dir-entry,
        siblings: list<dir-entry>,
        exhaustive: bool,
    }

    /// A Git tree handoff: the tree of an open and the commit it checked
    /// out, which the host sends back as the `validator` of `list-children`
    /// of the tree path once the tree is past its deadline.
    record subtree {
        tree: tree-ref,
        commit: string,
    }

    /// List-children result. `unchanged` answers a call with a `validator`:
    /// the cached page of that validator stands, with the validator it keeps
    /// from then on, or, without one, the commit of the tree of the path does.
    variant list-children-result {
        entries(dir-listing),
        subtree(subtree),
        unchanged(option<page-validator>),
        feed(list<feed-claim>),
    }

    /// A directory listing returned by a provider, pairing child entries
    /// with a signal about how the host should interpret absence.
    record dir-listing {
        entries: list<dir-entry>,
        exhaustive: bool,
        /// Resume token for a paged (non-exhaustive) listing; the host
        /// echoes it back as the `cursor` argument to continue.
        next-cursor: option<cursor>,
        /// The validator of this page: once the page is past its deadline,
        /// the host asks for it again with the token as the `validator` of
        /// `list-children`.
        validator: option<page-validator>,
    }

    /// The validator of a listing page, with the seconds of the interval of
    /// its upstream, which set the deadline of the page.
    record page-validator {
        token: version-token,
        interval: option<u32>,
    }

    /// Completed full-read result: the materialized bytes for the requested
    /// path. `bytes::canonical` references the canonical store (no copy);
    /// `bytes::deferred` is not valid here, since a read must answer.
    record read-file-result {
        content-type: option<string>,
        attrs: file-attrs,
        bytes: byte-source,
    }

    variant read-file-outcome {
        found(read-file-result),
        not-found(option<logical-id>),
        feed(list<feed-claim>),
    }

    // --- Feeds ---

    /// The resume state of a feed, opaque to the host, which keeps it per
    /// feed object and echoes it on the next `feed` call.
    type feed-token = string;

    /// The object of a feed: its logical id and the path of its anchor.
    record feed-object {
        id: logical-id,
        path: string,
    }

    /// A feed that answers for the path of an operation. `starts` marks an
    /// operation on a starting path of the feed.
    record feed-claim {
        object: feed-object,
        starts: bool,
    }

    /// The answer of one `feed` call: the facts of the feed stand, or one
    /// part of the answer, whose facts are the effects of the call.
    variant feed-answer {
        unchanged,
        part(feed-part),
    }

    /// One part of an answer: the token after it, whether more parts follow
    /// in the same answer, the tokens of the objects of inner feeds it
    /// brought, as the items of a page of rows, and each anchor of another
    /// facet of an object that it writes.
    record feed-part {
        token: feed-token,
        more: bool,
        inner: list<feed-state>,
        anchors: list<facet-anchor>,
    }

    /// An anchor of an object at another choice of a facet than the first,
    /// and the anchor of the claim of the object, with each facet at its first
    /// choice, where the facts of the object live.
    record facet-anchor {
        path: string,
        anchor: string,
    }

    /// The token of an inner feed, keyed by the logical id of its object.
    record feed-state {
        id: logical-id,
        token: feed-token,
    }

    /// What `projection.listing` returns of a listing.
    enum listing-form {
        count,
        names,
    }

    /// A listing of the projection with its completeness.
    record listing-facts {
        complete: bool,
        entries: listing-entries,
    }

    variant listing-entries {
        count(u64),
        names(list<string>),
    }

    /// Opened ranged-read handle. `open-file` is only valid for files
    /// projected with `proj-bytes::deferred(read-mode::ranged)`.
    record open-file-result {
        handle: file-handle,
        attrs: file-attrs,
    }

    /// Chunk bytes for an `open-file` handle.
    record read-chunk-result {
        content: list<u8>,
        eof: bool,
    }

    // --- Data types ---

    record http-request {
        method: string,
        url: string,
        headers: list<header>,
        body: option<list<u8>>,
    }

    record http-response {
        status: u16,
        headers: list<header>,
        body: list<u8>,
    }

    record header {
        name: string,
        value: string,
    }

    /// Open a repository with `commit` checked out.
    record git-open-request {
        clone-url: string,
        reference: option<string>,
        commit: string,
    }

    /// HTTP fetch that lands its response body in the host's disk-backed
    /// blob cache. The host derives identity from the validated request.
    record blob-fetch-request {
        method: string,
        url: string,
        headers: list<header>,
        body: option<list<u8>>,
    }

    /// Result of a successful `fetch-blob`. The body is on disk; only the
    /// metadata crosses the WIT.
    record blob-fetched {
        blob: blob-id,
        size: u64,
        content-type: option<string>,
        etag: option<string>,
        status: u16,
        response-headers: list<header>,
    }

    variant cursor {
        opaque(string),
        page(u32),
    }

    record git-repo-info {
        repo: repo-id,
        tree: tree-ref,
    }

    record log-entry {
        level: log-level,
        message: string,
    }

    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    variant provider-event {
        file-changed(string),
        webhook-received(list<u8>),
        timer-tick,
        auth-refreshed,
    }
}

// === Provider exports ===

interface lifecycle {
    use types.{effects, provider-error};

    /// Terminal-only in this iteration. It has no correlation id, so it
    /// cannot suspend on callouts unless the interface is explicitly
    /// changed later.
    initialize: func(config: list<u8>)
        -> tuple<result<_, provider-error>, effects>;
    shutdown: func();
}

interface namespace {
    use types.{canonical-input, correlation-id, cursor, effects, feed-answer, feed-token,
        file-handle, list-children-result, lookup-child-result, open-file-result,
        provider-error, read-chunk-result, read-file-outcome, version-token};

    lookup-child: async func(id: correlation-id, parent-path: string, name: string)
        -> tuple<result<lookup-child-result, provider-error>, effects>;
    /// `validator` is the validator of the cached page of `cursor`, or the
    /// commit of the tree of `path`.
    list-children: async func(id: correlation-id, path: string, cursor: option<cursor>, validator: option<version-token>)
        -> tuple<result<list-children-result, provider-error>, effects>;
    read-file: async func(id: correlation-id, path: string, content-type: string, cached-canonical: option<canonical-input>)
        -> tuple<result<read-file-outcome, provider-error>, effects>;
    open-file: async func(id: correlation-id, path: string)
        -> tuple<result<open-file-result, provider-error>, effects>;
    read-chunk: async func(id: correlation-id, handle: file-handle, offset: u64, len: u32)
        -> tuple<result<read-chunk-result, provider-error>, effects>;
    close-file: func(handle: file-handle);
    /// One call of the feed of the object anchored at `path`, from `token`.
    /// `start` is the path of the operation that starts the answer.
    feed: async func(id: correlation-id, path: string, token: option<feed-token>, start: option<string>)
        -> tuple<result<feed-answer, provider-error>, effects>;
}

interface notify {
    use types.{correlation-id, effects, provider-error, provider-event};

    on-event: async func(id: correlation-id, event: provider-event)
        -> tuple<result<_, provider-error>, effects>;
}

// === Host import ===

interface log {
    use types.{log-entry};

    log: func(entry: log-entry);
}

/// Reads of the projection the host keeps, for a feed operation.
interface projection {
    use types.{correlation-id, listing-facts, listing-form, provider-error};

    /// The listing of `path` in the projection, for a path in the subtree of
    /// the object of the feed operation `id`; none for a path without one.
    listing: func(id: correlation-id, path: string, form: listing-form)
        -> result<option<listing-facts>, provider-error>;
}

interface callouts {
    use types.{blob-fetch-request, callout-result, correlation-id, git-open-request, http-request};

    fetch: async func(id: correlation-id, req: http-request) -> callout-result;
    git-open-repo: async func(id: correlation-id, req: git-open-request) -> callout-result;
    fetch-blob: async func(id: correlation-id, req: blob-fetch-request) -> callout-result;
}

// === Worlds ===

world provider {
    import log;
    import callouts;
    import projection;
    export lifecycle;
    export namespace;
    export notify;
}
